  - m_Id: 207143034880
    m_Localized: "\uBD81\uD48D\uACFC \uD0DC\uC591"
    m_Metadata:
      m_Items: []
  - m_Id: 259131432960
    m_Localized: "\uD55C\uAD6D\uC5B4"
    m_Metadata:
      m_Items: []
  - m_Id: 321131634688
    m_Localized: "\uBD81\uD48D\uACFC \uD0DC\uC591\uC740 \uB458 \uC911 \uB204\uAC00 \uB354 \uAC15\uD55C\uC9C0\uB97C \uB450\uACE0 \uB2E4\uD22C\uACE0 \uC788\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8\uB54C \uB458\uC740 \uB9DD\uD1A0\uB97C \uB450\uB978 \uB098\uADF8\uB124 \uD55C \uC0AC\uB78C\uC774 \uAE38\uC744 \uB530\uB77C \uAC78\uC5B4\uC624\uB294 \uAC83\uC744 \uBCF4\uC558\uC2B5\uB2C8\uB2E4. \uB458\uC740 \uB098\uADF8\uB124\uC758 \uB9DD\uD1A0\uB97C \uBC97\uAE30\uB294 \uCABD\uC774 \uB354 \uAC15\uD558\uB2E4\uACE0 \uC778\uC815\uD558\uAE30\uB85C \uD588\uC2B5\uB2C8\uB2E4. \uBA3C\uC800 \uBD81\uD48D\uC774 \uC788\uB294 \uD798\uAECF \uBD88\uAE30 \uC2DC\uC791\uD588\uC2B5\uB2C8\uB2E4. \uADF8\uB7EC\uB098 \uBD81\uD48D\uC774 \uC138\uAC8C \uBD88\uBA74 \uBD88\uC218\uB85D \uB098\uADF8\uB124\uB294 \uB9DD\uD1A0\uB97C \uB354\uC6B1 \uB2E8\uB2E8\uD788 \uC5EC\uBA84\uACE0, \uACB0\uAD6D \uBD81\uD48D\uC740 \uD3EC\uAE30\uD558\uACE0 \uB9D0\uC558\uC2B5\uB2C8\uB2E4. \uC774\uC5B4\uC11C \uD0DC\uC591\uC774 \uB530\uB73B\uD558\uAC8C \uBE44\uCD94\uC790 \uB098\uADF8\uB124\uB294 \uACE7\uBC14\uB85C \uB9DD\uD1A0\uB97C \uBC97\uC5C8\uC2B5\uB2C8\uB2E4. \uADF8\uB9AC\uD558\uC5EC \uBD81\uD48D\uC740 \uD0DC\uC591\uC774 \uC790\uC2E0\uBCF4\uB2E4 \uB354 \uAC15\uD558\uB2E4\uB294 \uAC83\uC744 \uC778\uC815\uD560 \uC218\uBC16\uC5D0 \uC5C6\uC5C8\uC2B5\uB2C8\uB2E4."
    m_Metadata:
      m_Items: []
