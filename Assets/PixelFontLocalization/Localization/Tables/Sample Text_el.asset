  - m_Id: 207143034880
    m_Localized: "\u039F \u0392\u03BF\u03C1\u03B9\u03AC\u03C2 \u03BA\u03B1\u03B9 \u03BF \u0389\u03BB\u03B9\u03BF\u03C2"
    m_Metadata:
      m_Items: []
  - m_Id: 259131432960
    m_Localized: "\u0395\u03BB\u03BB\u03B7\u03BD\u03B9\u03BA\u03AC"
    m_Metadata:
      m_Items: []
  - m_Id: 321131634688
    m_Localized: "\u039F \u0392\u03BF\u03C1\u03B9\u03AC\u03C2 \u03BA\u03B1\u03B9 \u03BF \u0389\u03BB\u03B9\u03BF\u03C2 \u03C6\u03B9\u03BB\u03BF\u03BD\u03B9\u03BA\u03BF\u03CD\u03C3\u03B1\u03BD \u03B3\u03B9\u03B1 \u03C4\u03BF \u03C0\u03BF\u03B9\u03BF\u03C2 \u03B1\u03C0\u03CC \u03C4\u03BF\u03C5\u03C2 \u03B4\u03CD\u03BF \u03AE\u03C4\u03B1\u03BD \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B5\u03C1\u03BF\u03C2. \u0395\u03BA\u03B5\u03AF\u03BD\u03B7 \u03C4\u03B7 \u03C3\u03C4\u03B9\u03B3\u03BC\u03AE \u03B5\u03AF\u03B4\u03B1\u03BD \u03AD\u03BD\u03B1\u03BD \u03C4\u03B1\u03BE\u03B9\u03B4\u03B9\u03CE\u03C4\u03B7, \u03C4\u03C5\u03BB\u03B9\u03B3\u03BC\u03AD\u03BD\u03BF \u03C3\u03C4\u03BF\u03BD \u03BC\u03B1\u03BD\u03B4\u03CD\u03B1 \u03C4\u03BF\u03C5, \u03BD\u03B1 \u03C0\u03BB\u03B7\u03C3\u03B9\u03AC\u03B6\u03B5\u03B9 \u03C3\u03C4\u03BF\u03BD \u03B4\u03C1\u03CC\u03BC\u03BF. \u03A3\u03C5\u03BC\u03C6\u03CE\u03BD\u03B7\u03C3\u03B1\u03BD \u03C0\u03C9\u03C2 \u03CC\u03C0\u03BF\u03B9\u03BF\u03C2 \u03BA\u03B1\u03C4\u03AC\u03C6\u03B5\u03C1\u03BD\u03B5 \u03BD\u03B1 \u03BA\u03AC\u03BD\u03B5\u03B9 \u03C4\u03BF\u03BD \u03C4\u03B1\u03BE\u03B9\u03B4\u03B9\u03CE\u03C4\u03B7 \u03BD\u03B1 \u03B2\u03B3\u03AC\u03BB\u03B5\u03B9 \u03C4\u03BF\u03BD \u03BC\u03B1\u03BD\u03B4\u03CD\u03B1 \u03C4\u03BF\u03C5 \u03B8\u03B1 \u03B8\u03B5\u03C9\u03C1\u03BF\u03CD\u03BD\u03C4\u03B1\u03BD \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B5\u03C1\u03BF\u03C2. \u03A0\u03C1\u03CE\u03C4\u03BF\u03C2 \u03BF \u0392\u03BF\u03C1\u03B9\u03AC\u03C2 \u03AC\u03C1\u03C7\u03B9\u03C3\u03B5 \u03BD\u03B1 \u03C6\u03C5\u03C3\u03AC \u03BC\u03B5 \u03CC\u03BB\u03B7 \u03C4\u03BF\u03C5 \u03C4\u03B7 \u03B4\u03CD\u03BD\u03B1\u03BC\u03B7. \u038C\u03C3\u03BF \u03C0\u03B9\u03BF \u03B4\u03C5\u03BD\u03B1\u03C4\u03AC \u03C6\u03C5\u03C3\u03BF\u03CD\u03C3\u03B5, \u03C4\u03CC\u03C3\u03BF \u03C0\u03B9\u03BF \u03C3\u03C6\u03B9\u03C7\u03C4\u03AC \u03C4\u03C5\u03BB\u03B9\u03B3\u03CC\u03C4\u03B1\u03BD \u03BF \u03C4\u03B1\u03BE\u03B9\u03B4\u03B9\u03CE\u03C4\u03B7\u03C2 \u03C3\u03C4\u03BF\u03BD \u03BC\u03B1\u03BD\u03B4\u03CD\u03B1 \u03C4\u03BF\u03C5. \u03A3\u03C4\u03BF \u03C4\u03AD\u03BB\u03BF\u03C2, \u03BF \u0392\u03BF\u03C1\u03B9\u03AC\u03C2 \u03B1\u03BD\u03B1\u03B3\u03BA\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5 \u03BD\u03B1 \u03B5\u03B3\u03BA\u03B1\u03C4\u03B1\u03BB\u03B5\u03AF\u03C8\u03B5\u03B9 \u03C4\u03B7\u03BD \u03C0\u03C1\u03BF\u03C3\u03C0\u03AC\u03B8\u03B5\u03B9\u03B1. \u038E\u03C3\u03C4\u03B5\u03C1\u03B1 \u03BF \u0389\u03BB\u03B9\u03BF\u03C2 \u03AC\u03C1\u03C7\u03B9\u03C3\u03B5 \u03BD\u03B1 \u03B6\u03B5\u03C3\u03C4\u03B1\u03AF\u03BD\u03B5\u03B9 \u03C4\u03BF\u03BD \u03C4\u03B1\u03BE\u03B9\u03B4\u03B9\u03CE\u03C4\u03B7 \u03BC\u03B5 \u03C4\u03B9\u03C2 \u03B1\u03BA\u03C4\u03AF\u03BD\u03B5\u03C2 \u03C4\u03BF\u03C5 \u03BA\u03B1\u03B9 \u03B5\u03BA\u03B5\u03AF\u03BD\u03BF\u03C2 \u03AD\u03B2\u03B3\u03B1\u03BB\u03B5 \u03B1\u03BC\u03AD\u03C3\u03C9\u03C2 \u03C4\u03BF\u03BD \u03BC\u03B1\u03BD\u03B4\u03CD\u03B1 \u03C4\u03BF\u03C5. \u0388\u03C4\u03C3\u03B9, \u03BF \u0392\u03BF\u03C1\u03B9\u03AC\u03C2 \u03B1\u03BD\u03B1\u03B3\u03BA\u03AC\u03C3\u03C4\u03B7\u03BA\u03B5 \u03BD\u03B1 \u03C0\u03B1\u03C1\u03B1\u03B4\u03B5\u03C7\u03C4\u03B5\u03AF \u03C0\u03C9\u03C2 \u03BF \u0389\u03BB\u03B9\u03BF\u03C2 \u03AE\u03C4\u03B1\u03BD \u03B4\u03C5\u03BD\u03B1\u03C4\u03CC\u03C4\u03B5\u03C1\u03BF\u03C2 \u03B1\u03C0\u03CC \u03C4\u03BF\u03BD \u03AF\u03B4\u03B9\u03BF."
    m_Metadata:
      m_Items: []
  - m_Id: 161349987459072
    m_Localized: "\u0393\u03BB\u03CE\u03C3\u03C3\u03B1"
    m_Metadata:
